<!DOCTYPE html>
<html lang="en">
<head>
    <!-- relative path -->
    <link rel="stylesheet" href="css/loginstyle.css">
     <link rel="stylesheet" href="/aion/css/loginstyle.css">
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign up</title>
</head>
<body>

    <div class="sign-up-container">
     <div class="signup-div">

         <h1 class="sign-up-text">Login</h1>

         <p class="sign-up-info">Please fill in this form to login</p>

         <% if(locals.logout){ %>
            <div class="logouttext">
                <p><%= logout %></p>


            </div>


        <% } %>







     </div>
     <div class="divider">
        <hr>
    </div>

      <div class="sign-up-form">

        <form  method="POST">

            <label for="e-mail">Email</label><br>
            <input class="userinput" type="email" id="email" name="email" placeholder="Email*"><br><br>
            <label for="password">Password</label><br>
            <input class="userinput" type="password" id="password" name="pass" placeholder="Password*"><br>


            <input class="signup-btn" type="submit" value="Submit">
            <p class="donthave">Dont have an account? <a href="/register">Register</a></p>
        </form>
      </div>
    </div>

</body>
</html>