<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="css/signup.css">
    <link rel="stylesheet" href="/aion/css/signup.css">
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign up</title>
</head>
<body>
    <div class="sign-up-container">
     <div class="signup-div">
         <h1 class="sign-up-text">Create Account</h1>
         <p class="sign-up-info">Already have an account? <a href="/login">Sign in</a></p>


     </div>
     <div class="divider">
        <hr>
    </div>

      <div class="sign-up-form">

        <form  method="POST">
            <label for="first_name">First Name</label>
            <input class="userinput" type="name" id="name" name="first_name" placeholder="First Name*">
            <label for="name">Last Name</label>
            <input class="userinput" type="name" id="lastname" name="lastname" placeholder="Last Name*">
            <label for="email">Email</label>
            <input class="userinput" type="email" id="email" name="email" placeholder="Email*">
            <label for="password">Password</label>
            <input class="userinput" type="password" id="password" name="password" placeholder="Password*">
            <p><a href="">Forgot password?</a> </p>
            <label for="name"></label>

            <input class="signup-btn" type="submit" value="Sign up">
        </form>
      </div>
    </div>

</body>
</html>